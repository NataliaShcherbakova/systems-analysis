@startuml
title IBD: PipelineBlock - Внутренние потоки данных
skinparam backgroundColor #FEFEFE
skinparam defaultFontName Arial
skinparam defaultFontSize 11

' Контейнер PipelineBlock
package "PipelineBlock" {
  
  ' Части (instances блоков)
  [qc_part\n:QCModule] as qc
  [align_part\n:AlignmentModule] as align
  [variant_part\n:VariantCaller] as vc
  
  ' Потоки данных между частями
  qc --> align : BAM
  align --> vc : BAM (sorted)
  
  ' Выходные данные
  vc --> [output_data\n:VCF (filtered)]
}

' Внешние порты
[inputPort\n:FASTQ] as input
[outputPort\n:VCF] as output

' Связи с портами
input --> qc : входные данные
output_data --> output : результат

' Легенда
legend right
  **Потоки данных:**
  FASTQ → QC → BAM → Alignment → BAM (sorted) → Variant Calling → VCF (filtered)
  
  **Порты:**
  ■ inputPort: FASTQ (вход)
  ■ outputPort: VCF (выход)
endlegend

@enduml
