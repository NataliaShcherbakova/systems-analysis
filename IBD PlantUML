@startuml
title IBD: PipelineBlock
skinparam backgroundColor #FEFEFE
skinparam defaultFontName Arial
skinparam defaultFontSize 10

left to right direction

' Внешние порты
rectangle "ninputPort\nFASTQ" as in_port #C8E6C9
rectangle "noutputPort\nVCF" as out_port #FFCDD2

' Внутренние части
package "PipelineBlock" {
  rectangle "qc_part\n:QCModule" as qc #BBDEFB
  rectangle "align_part\n:AlignmentModule" as align #BBDEFB
  rectangle "variant_part\n:VariantCaller" as vc #BBDEFB
}

' Связи с подписями
in_port --> qc : FASTQ
qc --> align : BAM
align --> vc : BAM sorted
vc --> out_port : VCF filtered

@enduml
